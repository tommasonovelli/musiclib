# Vibrance MusicLib: settings of compose.yaml. Copy this file to `.env` next
# to compose.yaml, set POSTGRES_PASSWORD, then `chmod 600 .env`.
# docs/operations.md explains every setting.

# The database password. Left empty, the DEFAULT PASSWORD `musiclib` is used:
# better set your own BEFORE THE FIRST START, for example the output of
#   openssl rand -hex 32
# (the README's install block writes one here for you). PostgreSQL reads it
# only when it creates its database, at the first start: changing it here
# later does not change the database's password, and the app can no longer
# connect (docs/operations.md, "First start", explains how to change it).
POSTGRES_PASSWORD=

# The exact address you open in the browser, scheme, host and port: the API
# answers only requests for this host (localhost and 127.0.0.1 differ). Keep
# its port equal to MUSICLIB_PORT, and its host to MUSICLIB_BIND for LAN access.
PUBLIC_ORIGIN=http://127.0.0.1:8080

# Optional settings, with their defaults.

# Address and port published on the host. Loopback only by default; for LAN
# access set the machine's address here and use it in PUBLIC_ORIGIN.
#MUSICLIB_BIND=127.0.0.1
#MUSICLIB_PORT=8080

# Host directory with the music to import, mounted read-only on /import. It
# must exist before starting: Compose does not create it.
#MUSICLIB_IMPORT=./import

# /data (originals and the generated library) and /backup: named volumes by
# default, or absolute host paths on local ext4 owned by the app's uid.
#MUSICLIB_DATA=data
#MUSICLIB_BACKUP=backup

# Number of workers, 1 to 16. Empty: max(1, min(4, CPUs)).
#WORKERS=

# The app's uid:gid. The image uses 1000:1000, and new named volumes are owned
# by it; another uid needs MUSICLIB_DATA and MUSICLIB_BACKUP as host
# directories owned by that uid.
#MUSICLIB_UID=1000
#MUSICLIB_GID=1000

# Source build only (a clone of the repository): build and run the app from
# source with compose.dev.yaml, for plain `docker compose` commands and the
# scripts/ maintenance wrappers alike.
#COMPOSE_FILE=compose.dev.yaml
